{
  "name": "npweb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:public": "npm --prefix frontend run dev",
    "dev:admin": "npm --prefix admin-frontend run dev",
    "dev:backend": "powershell -Command \"& ./backend/venv/Scripts/python ./backend/run.py\"",
    "build": "tsc -b && vite build",
    "build:public": "npm --prefix frontend run build",
    "build:admin": "npm --prefix admin-frontend run build",
    "build:all": "npm run build:public && npm run build:admin",
    "test:backend": "powershell -Command \"& ./backend/venv/Scripts/pytest -v -p no:cacheprovider ./backend/tests/test_api.py\"",
    "seed:db": "powershell -Command \"& ./backend/venv/Scripts/python ./database/seed_data.py\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
