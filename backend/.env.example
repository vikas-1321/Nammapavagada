# ==============================================================================
# Namma Pavagada - Backend Environment Configuration
# ==============================================================================

# Application Environment (development | staging | production)
FLASK_ENV=development
PORT=5000

# Security & Session Secrets
SECRET_KEY=change-this-in-production-use-a-strong-random-key
JWT_SECRET_KEY=change-this-jwt-secret-in-production-use-a-strong-random-key
JWT_EXPIRY_HOURS=24

# Database Configuration
# Local Development: SQLite
DATABASE_URL=sqlite:///namma_pavagada.db
# AWS RDS PostgreSQL Example:
# DATABASE_URL=postgresql://np_admin:YourDbPassword@np-rds-db.cxxxxxxxx.ap-south-1.rds.amazonaws.com:5432/namma_pavagada

# AWS Credentials & S3 Storage
# If left blank, the backend automatically uses secure local disk storage fallback during development
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=namma-pavagada-media
S3_USE_LOCAL_FALLBACK=True

# CORS Configuration (Comma-separated origins for public & admin websites)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Seed Admin Credentials (used during database init / seeding)
INITIAL_ADMIN_EMAIL=admin@nammapavagada.com
INITIAL_ADMIN_PASSWORD=PavagadaAdmin@2026
INITIAL_ADMIN_NAME="Chief Administrator"
